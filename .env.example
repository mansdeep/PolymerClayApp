# Copy to .env and fill in.

# --- Local dev (Postgres via docker-compose.yml) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/polymerclay?schema=public"
# Locally there is no separate pooled/direct connection, so point directUrl at the same DB:
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/polymerclay?schema=public"

# --- Production (Neon on Vercel) ---
# The Vercel <-> Neon integration injects these automatically. If your integration
# only exposes POSTGRES_* names, add these two as extra env vars pointing at:
#   DATABASE_URL           -> the POOLED connection string
#   DATABASE_URL_UNPOOLED  -> the DIRECT (non-pooling) connection string

# Secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string"
