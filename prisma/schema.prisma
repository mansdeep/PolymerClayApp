// Prisma schema for Polymer Clay Inspo
//
// Postgres everywhere:
//   - Local:      docker compose up -d db   (see docker-compose.yml + .env.example)
//   - Production: Neon on Vercel injects DATABASE_URL (pooled) and
//                 DATABASE_URL_UNPOOLED (direct, used for migrations).
// See README.md for the full deploy guide.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String
  address      String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---- Content tables (seeded, read-only in the app) ----

// difficulty is a plain string ("Easy" | "Medium" | "Hard"), validated in app code
// (src/lib/difficulty.ts) rather than a DB enum.

model Project {
  id         String @id @default(cuid())
  name       String
  usage      String
  procedure  String
  difficulty String
}

model Technique {
  id         String @id @default(cuid())
  name       String
  purpose    String
  howTo      String
  difficulty String
}

model Finish {
  id         String @id @default(cuid())
  name       String
  result     String
  notes      String
  difficulty String
}
